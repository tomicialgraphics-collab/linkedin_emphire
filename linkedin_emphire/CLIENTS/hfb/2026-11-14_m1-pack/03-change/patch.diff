+    def append_batch(self, records):
+        """Several records, one write call, one fsync, and a marker linking them.
+
+        The conflict path used to write the verdict, and then, in a second append with its own
+        fsync, the record that names the conflict. A crash between the two left a store that
+        reported a conflict it could no longer name. One write and one fsync means the batch is
+        whole or absent. A reader that finds part of a batch withholds what it found and says
+        so, because half of a two-part claim is not a smaller claim.
+        """
+        if not records:
+            return []
+        prepared = []
+        seq = self.seq
+        for record in records:
+            seq += 1
+            record = dict(record)
+            record["store_seq"] = seq
+            prepared.append(record)
+        blob_key = json.dumps(prepared, sort_keys=True)
+        batch_id = hashlib.sha256(blob_key.encode("utf-8")).hexdigest()[:16]
+        for index, record in enumerate(prepared, start=1):
+            record["batch"] = {"id": batch_id, "index": index, "of": len(prepared)}
+            record["digest"] = frame(record)
+            if self.failpoint == "verdict" and record.get("kind") == "verdict":
+                raise JournalError("injected: the journal refused a verdict write")
+        blob = "".join(json.dumps(record, sort_keys=True) + "\n" for record in prepared)
+        before = self._size()
+        if before and not self._ends_clean():
+            before = self._cut_damaged_tail(before)
+        try:
+            with open(self.path, "a", encoding="utf-8", newline="\n") as fh:
+                fh.write(blob)
+                fh.flush()
+                os.fsync(fh.fileno())
+        except OSError as exc:
+            self._rollback(before, exc)
+            raise JournalError("journal did not take the batch: %s" % exc)
+        self.seq = seq
+        return prepared
+
