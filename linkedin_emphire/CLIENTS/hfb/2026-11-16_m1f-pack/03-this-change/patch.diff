+
+class ShortWrite:
+    # A file that stops one byte before the end of the write, then fails. The batch reaches
+    # the disk whole apart from its final terminator: everything arrived, the file never said
+    # so. This is the crash the reviewer injected, arranged without touching the store.
+    def __init__(self, fh):
+        self.fh = fh
+
+    def write(self, data):
+        self.fh.write(data[:-1] if data.endswith("\n") else data[: max(1, len(data) // 2)])
+        raise OSError("injected: the write stopped one byte short")
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *a):
+        self.fh.close()
+        return False
+
+
+def short_open(path, mode="r", *a, **k):
+    fh = real_open(path, mode, *a, **k)
+    if mode.startswith("a") and str(path) == journal:
+        return ShortWrite(fh)
+    return fh
+
+
+s = S.Store(S.Journal(journal))
+s.handle({"cmd": "issue", "action_id": "H-1"})
+first = {"action_id": "H-1", "verdict": "BLOCK", "signature": None}
+second = {"action_id": "H-1", "verdict": "ALLOW", "signature": None}
+s.handle({"cmd": "verdict", "record": first})
+before = open(journal, "rb").read()
+
+s.journal.failpoint = "rollback"
+S.open = short_open
+crash = s.handle({"cmd": "verdict", "record": second})
+S.open = real_open
+s.journal.failpoint = ""
+
+torn = open(journal, "rb").read()
+retry = s.handle({"cmd": "verdict", "record": second})
+after = open(journal, "rb").read()
+
+out["crash_reply"] = crash
+out["retry_reply"] = retry
+out["torn_bytes"] = len(torn) - len(before)
+out["torn_sha"] = hashlib.sha256(torn[len(before):]).hexdigest()
+out["journal_intact"] = after == torn
+out["journal_bytes"] = [len(torn), len(after)]
+out["quarantine_files"] = sorted(os.path.basename(p) for p in glob.glob(os.path.join(work, "*.bin")))
+
+restarted = S.Store(S.Journal(journal))
+out["gap_after_restart"] = restarted.journal.gap and {
+    k: restarted.journal.gap[k] for k in ("store_seq", "kind", "bytes")}
+out["write_after_restart"] = restarted.handle({"cmd": "issue", "action_id": "H-9"})
