+    """A genuinely torn line, quarantined by recovery before a retry that then fails at open.
+
+    This is the limitation the reviewer scoped the guarantee to, and it is pinned rather than
+    fixed: the complete record in f24 is a gap and may not be cut, a torn line is damage and is
+    quarantined by recovery, and the `disk_state: unchanged` on the retry that follows is a claim
+    about that append rather than about the file recovery has already repaired.
+    """
+    tree = fresh_copy(repo, "f25")
+    work = tempfile.mkdtemp(prefix="hfb-f25-run-")
+    script = os.path.join(work, "torn_line_case.py")
+    with open(script, "w", encoding="utf-8") as fh:
+        fh.write(STORE_TORN_LINE_CASE)
+    proc = subprocess.run([sys.executable, script, tree], capture_output=True, text=True,
+                          timeout=120)
+    if proc.returncode != 0:
+        return False, "the case did not run: %s" % (proc.stderr or proc.stdout)[-300:]
+    out = json.loads(proc.stdout.strip().splitlines()[-1])
+
+    reply = out["retry_reply"] or {}
+    # Recovery must quarantine the torn bytes, whole and named, and must not call it a gap.
+    quarantined = (out["discarded"] == out["torn_bytes"]
+                   and out["quarantine_sha"] == out["torn_sha"]
+                   and out["quarantine_bytes"] == out["torn_bytes"]
+                   and bool(out["quarantine_file"])
+                   and out["quarantine_files"] == [out["quarantine_file"]])
+    not_a_gap = out["gap"] is None
