+def encoding_of(raw):
+    """What the bytes actually are, not what the extension suggests.
+
+    Line endings are part of the answer. An object that already holds CRLF cannot be changed by
+    a checkout setting, and a reader comparing digests needs to know which of the two it has.
+    """
+    if raw.startswith(b"\xff\xfe"):
+        return "utf-16le+bom"
+    if raw.startswith(b"\xfe\xff"):
+        return "utf-16be+bom"
+    if raw.startswith(b"\xef\xbb\xbf"):
+        return "utf-8+bom+crlf" if b"\r\n" in raw else "utf-8+bom"
+    try:
+        raw.decode("utf-8")
+        return "utf-8+crlf" if b"\r\n" in raw else "utf-8"
+    except UnicodeDecodeError:
+        return "binary"
+
+
+def served_digest(raw, encoding):
+    """What a browser will hash, for the files a hosting layer re-encodes on the way out.
+
+    GitHub serves text as UTF-8 with a BOM. A file stored as UTF-16LE therefore has two digests
+    that are both correct: the one of the object and the one of the response. Publishing only the
+    first is what made an independent reviewer report a mismatch on 4 November, and publishing
+    only the second would be worse.
+    """
+    import hashlib
+
+    if encoding == "utf-16le+bom":
+        return hashlib.sha256(raw.decode("utf-16").encode("utf-8-sig")).hexdigest()
+    if encoding == "utf-16be+bom":
+        return hashlib.sha256(raw.decode("utf-16").encode("utf-8-sig")).hexdigest()
+    return None
+
 
+def fsync_dir(path):
+    """Make a directory entry durable. POSIX only, silently skipped elsewhere."""
+    try:
+        fd = os.open(str(path), os.O_RDONLY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    except OSError:
+        pass
+    finally:
+        os.close(fd)
+
+
+def fsync_file(path):
+    with open(path, "rb") as fh:
+        os.fsync(fh.fileno())
 
