+STORE_TORN_BATCH_CASE = r"""
+import glob, hashlib, json, os, sys, tempfile
+sys.path.insert(0, os.path.join(sys.argv[1], "bench"))
+import store as S
+
+work = tempfile.mkdtemp(prefix="hfb-f24-")
