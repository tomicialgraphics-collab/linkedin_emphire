+with open(journal, "ab") as fh:
+    fh.write(torn)
+out["bytes_before_recovery"] = os.path.getsize(journal)
+
+# recovery, in a fresh process over that file
+s2 = S.Store(S.Journal(journal))
+out["bytes_after_recovery"] = os.path.getsize(journal)
+out["discarded"] = s2.journal.discarded
+out["torn_bytes"] = len(torn)
+out["torn_sha"] = hashlib.sha256(torn).hexdigest()
+q = s2.journal.quarantine or {}
+out["quarantine_file"] = q.get("file")
+out["quarantine_sha"] = q.get("sha256")
+out["quarantine_bytes"] = q.get("bytes")
+out["quarantine_files"] = sorted(os.path.basename(p) for p in glob.glob(os.path.join(work, "*.bin")))
+out["gap"] = s2.journal.gap
+
+
+def failing_open(path, mode="r", *a, **k):
+    if str(path) == journal and mode.startswith("a"):
+        raise OSError(5, "Input/output error")
+    return real_open(path, mode, *a, **k)
+
+
+S.open = failing_open
+reply = s2.handle({"cmd": "verdict", "record": {"action_id": "T-1", "verdict": "ALLOW",
+                                                "signature": None}})
+S.open = real_open
+out["retry_reply"] = reply
+out["bytes_after_retry"] = os.path.getsize(journal)
+print(json.dumps(out, default=str))
