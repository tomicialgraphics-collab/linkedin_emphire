+name: check
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+
+      - name: Validate the checklist source
+        run: python3 tools/validate.py
+
+      - name: Check rendered files are up to date
+        run: python3 tools/render.py --check
+
+      - name: Coverage tool runs on the example
+        run: python3 tools/coverage.py examples/status-example.json -o /dev/null
+
+      - name: Interval tool runs
+        run: python3 tools/wilson.py 3 20
+
+      - name: No local paths, no retired identity strings
+        run: |
+          if grep -rInE "/home/user/|[A-Za-z]:\\\\Users" --include="*.md" --include="*.json" . ; then
+            echo "local path found"; exit 1
+          fi
