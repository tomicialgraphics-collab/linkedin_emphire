+def publish(staging, package, text):
+    """Publish the record, then the package. The record is never missing when the package exists.
+
+    Called after archive_run has built and fsynced the staging directory. The package is staged
+    beside its final name and fsynced before either rename happens, so the second rename cannot
+    fail on a full disk after the first has succeeded. A crash between the renames leaves a record
+    with no package, which is the safe direction and is detectable, because RUN.json names the
+    digest of the package that was meant to sit beside it.
+    """
+    package = Path(package).resolve()
+    staging = Path(staging).resolve()
+    final_record = package.parent / "run_record"
+
+    pkg_stage = package.with_name(package.name + ".staging")
+    pkg_stage.write_text(text, encoding="utf-8")
+    fsync_file(pkg_stage)
+
+    if final_record.exists():
+        previous = package.parent / ("run_record.previous-%s"
+                                     % datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S"))
+        os.replace(final_record, previous)
+
+    os.replace(staging, final_record)
+    fsync_dir(package.parent)
+    os.replace(pkg_stage, package)
+    fsync_dir(package.parent)
+    return final_record, package
